{
  "ApplicationName": "Hybrid Identity Reporter",
  "Version": "0.1.0",
  "DefaultInactiveDays": 90,
  "Paths": {
    "Reports": "Reports",
    "Archive": "Archive",
    "Logs": "Logs",
    "Templates": "Templates"
  },
  "Logging": {
    "Level": "INFO",
    "RetainDays": 90
  },
  "Exports": {
    "CsvDelimiter": ";",
    "ArchiveExistingReports": true
  },
  "Runtime": {
    "InstallTimeoutMinutes": 30,
    "MaxUiLogCharacters": 60000,
    "LargeResultWarningThreshold": 10000
  }
}
